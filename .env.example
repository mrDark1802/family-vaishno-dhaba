# ==============================================================================
# Family Vaishno Dhaba - Environment Variables Configuration
# ==============================================================================
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env for local development.

# Application Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=fvd_admin
POSTGRES_PASSWORD=fvd_secure_password_dev_2026
POSTGRES_DB=fvd_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Prisma Connection URL
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ------------------------------------------------------------------------------
# Backend API Service (apps/api)
# ------------------------------------------------------------------------------
API_PORT=4000
API_PREFIX=api
API_URL=https://family-vaishno-dhaba.vercel.app

# Security & Authentication
# Generate strong 64+ char random strings in production
JWT_SECRET=dev_jwt_secret_key_change_in_production_fvd_secure_2026_xyz
JWT_EXPIRATION=7d
COOKIE_SECRET=dev_cookie_signing_secret_key_change_in_production_2026
TOTP_ENCRYPTION_KEY=fvd_totp_encryption_key_32_bytes_dev_2026_change_in_production_key!

# Google OAuth 2.0 / OpenID Connect (Backend-only credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://family-vaishno-dhaba.vercel.app/api/auth/google/callback

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=https://family-vaishno-dhaba.vercel.app,http://localhost:3000,http://localhost:3001

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# Payments Gateway (Razorpay / Mock)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev_razorpay_webhook_secret_fvd_2026
RAZORPAY_PAYMENT_PAGE_ID=
RAZORPAY_PAYMENT_PAGE_URL=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_PAYMENT_PAGE_URL=

# ------------------------------------------------------------------------------
# Frontend Web App (apps/web)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_RESTAURANT_NAME="Family Vaishno Dhaba"
NEXT_PUBLIC_RESTAURANT_TAGLINE="Authentic Punjabi & Himachali Pure Vegetarian Cuisine"

# ------------------------------------------------------------------------------
# Admin Portal (apps/admin)
# ------------------------------------------------------------------------------
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api
