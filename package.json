{
  "name": "family-vaishno-dhaba",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade online food ordering platform for Family Vaishno Dhaba (Punjabi & Himachali Cuisine)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@repo/api",
    "dev:admin": "turbo run dev --filter=@repo/admin",
    "start:api": "turbo run dev --filter=@repo/api",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prettier": "^3.5.1",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
